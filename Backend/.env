# =====================================================
# MOSSOMBI BACKEND - VARIABLES D'ENVIRONNEMENT (LOCAL)
# =====================================================

NODE_ENV=development
PORT=3000
SERVER_NAME=mossombi-local
API_VERSION=v1

# 🐘 BASE DE DONNÉES (POSTGRESQL via Docker Compose)
# Match direct avec les identifiants de docker-compose.yml
DATABASE_URL=postgresql://postgres:Kbg-0042@localhost:15432/mossombi
DB_SYNCHRONIZE=true
TYPEORM_LOGGING=false
DB_SSL=false

# 🔴 REDIS (Pour le Rate Limiting et Scoket.io en temps réel)
REDIS_HOST=localhost
REDIS_PORT=6379

# 🔐 JWT & SÉCURITÉ
JWT_SECRET=super-secret-local-mossombi-key-for-dev-2026
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# 🚦 RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# 🌍 CORS (Autorise l'appli Web et l'appli Mobile Expo/Flutter)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,*

# 📁 UPLOADS
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# 📊 LOGGING
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# 📱 WHATSAPP API (Serveur local - port 3006)
WHATSAPP_API_URL=http://localhost:3006
WHATSAPP_API_KEY=6fd21f6c-8315-466e-9332-7ebc75ba08f4
WHATSAPP_SESSION_ID=JUSTE
WHATSAPP_SENDER_NUMBER=242053318784

# 💸 PAYMENT OS (Agrégateur de paiement externe)
PAYMENT_OS_URL=http://localhost:3004
PAYMENT_OS_PROJECT_ID=proj_5EF5C26A
PAYMENT_OS_API_KEY=pk_live_ece4cd25bfda46038c1c3dc5c26ca95d

# 🤖 INTELLIGENCE ARTIFICIELLE (Produits & Nettoyage)
