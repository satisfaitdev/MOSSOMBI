# =====================================================
# MOSSOMBI BACKEND - VARIABLES D'ENVIRONNEMENT
# =====================================================

# 🔧 APPLICATION
NODE_ENV=development
PORT=3000
SERVER_NAME=mossombi-dev
API_VERSION=v1

# 🔐 JWT & SÉCURITÉ
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# 📊 SUPABASE
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 📱 SMS & NOTIFICATIONS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# 📧 EMAIL (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# 📁 STORAGE & UPLOADS
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# 🚦 RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 📊 LOGGING
LOG_LEVEL=info
LOG_FILE=logs/app.log

# 🌍 CORS
CORS_ORIGIN=http://localhost:8081,exp://192.168.1.100:8081

# 🤖 INTELLIGENCE ARTIFICIELLE (Google Gemini / Imagen 3 / Veo)
# Obtenez une clé sur https://aistudio.google.com/
# Gemini sera utilisé pour le détourage image (Imagen) et la génération vidéo rotative 3D (Veo).
GEMINI_API_KEY=your-gemini-api-key-here
