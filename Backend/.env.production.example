# =====================================================
# CONFIGURATION PRODUCTION MOSSOMBI
# Copiez ce fichier vers .env.production et configurez
# =====================================================

# =====================================================
# 🔧 CONFIGURATION GÉNÉRALE
# =====================================================
NODE_ENV=production
PORT=3000
SERVER_NAME=mossombi-prod-1
API_VERSION=v1

# =====================================================
# 🗄️ BASE DE DONNÉES SUPABASE
# =====================================================
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =====================================================
# 🔴 REDIS POUR RATE LIMITING
# =====================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# =====================================================
# 📧 ALERTES EMAIL
# =====================================================
EMAIL_ALERTS_ENABLED=true
ADMIN_EMAILS=admin@mossombi.com,security@mossombi.com
EMAIL_FROM=security@mossombi.com

# Configuration SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# =====================================================
# 📱 ALERTES SMS (TWILIO)
# =====================================================
SMS_ALERTS_ENABLED=true
ADMIN_PHONES=+242066123456,+242066789012
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890

# =====================================================
# 🔗 WEBHOOKS (SLACK/TEAMS)
# =====================================================
WEBHOOK_ALERTS_ENABLED=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/TEAMS/WEBHOOK

# =====================================================
# 📱 WHATSAPP API
# =====================================================
WHATSAPP_API_URL=your_whatsapp_api_url
WHATSAPP_API_KEY=your_whatsapp_api_key

# =====================================================
# 🔐 SÉCURITÉ
# =====================================================
JWT_SECRET=your_very_secure_jwt_secret_key_here
AUDIT_ENCRYPTION_KEY=your_audit_encryption_key_here

# =====================================================
# 📊 MONITORING
# =====================================================
# Métriques Prometheus (optionnel)
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Healthcheck
HEALTH_CHECK_ENABLED=true

# =====================================================
# 🔍 LOGGING
# =====================================================
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/app.log

# =====================================================
# 🚀 PERFORMANCE
# =====================================================
# Clustering
CLUSTER_ENABLED=true
CLUSTER_WORKERS=auto

# Compression
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6

# Cache
CACHE_TTL=3600

# =====================================================
# 🛡️ RATE LIMITING CONFIGURATION
# =====================================================
# Limites par IP (requêtes/fenêtre en secondes)
RATE_LIMIT_IP_GENERAL=100/900        # 100 req/15min
RATE_LIMIT_IP_AUTH=20/900            # 20 auth/15min
RATE_LIMIT_IP_SENSITIVE=5/300        # 5 sensibles/5min

# Limites par utilisateur
RATE_LIMIT_USER_GENERAL=200/3600     # 200 req/heure
RATE_LIMIT_USER_AUTH=10/900          # 10 auth/15min
RATE_LIMIT_USER_FINANCIAL=20/3600    # 20 transactions/heure

# Seuils de blocage IP
BLOCK_THRESHOLD_SUSPICIOUS=3         # 3 violations -> 1h
BLOCK_THRESHOLD_MALICIOUS=5          # 5 violations -> 24h
BLOCK_THRESHOLD_PERMANENT=10         # 10 violations -> permanent

# =====================================================
# 📈 MONITORING THRESHOLDS
# =====================================================
ALERT_RESPONSE_TIME=5000             # 5 secondes
ALERT_ERROR_RATE=0.1                 # 10%
ALERT_MEMORY_USAGE=0.8               # 80%
ALERT_BLOCKED_IPS_HOUR=50            # 50 IPs/heure
ALERT_BRUTE_FORCE_HOUR=100           # 100 tentatives/heure

# =====================================================
# 🗄️ AUDIT DATABASE
# =====================================================
AUDIT_DB_ENABLED=true
AUDIT_BATCH_SIZE=100
AUDIT_FLUSH_INTERVAL=30000           # 30 secondes
AUDIT_RETENTION_DAYS=90              # 90 jours

# =====================================================
# 🔒 SECURITY FEATURES
# =====================================================
# Password Security
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_COMPLEX=true
PASSWORD_HISTORY_SIZE=10
PASSWORD_CHECK_COMPROMISED=true

# Session Security
MAX_SESSIONS_PER_USER=3
SESSION_TIMEOUT=86400000             # 24 heures
DEVICE_TRUST_DURATION=2592000000    # 30 jours

# OTP Security
OTP_MAX_ATTEMPTS=3
OTP_BLOCK_DURATION_1=1800000        # 30 minutes
OTP_BLOCK_DURATION_2=3600000        # 1 heure
OTP_BLOCK_DURATION_3=86400000       # 24 heures

# =====================================================
# 🌍 GEOLOCATION (PRIORITÉ 2)
# =====================================================
GEOLOCATION_ENABLED=false
GEOLOCATION_API_KEY=your_geolocation_api_key
GEOLOCATION_SUSPICIOUS_DISTANCE=100  # 100km

# =====================================================
# 🔐 2FA (PRIORITÉ 2)
# =====================================================
TWO_FACTOR_ENABLED=false
TWO_FACTOR_ISSUER=Mossombi
TOTP_WINDOW=1

# =====================================================
# 📱 MOBILE SECURITY (PRIORITÉ 2)
# =====================================================
MOBILE_SECURITY_ENABLED=false
DETECT_JAILBREAK=true
CERTIFICATE_PINNING=true

# =====================================================
# 🔍 ADVANCED MONITORING (OPTIONNEL)
# =====================================================
# Elasticsearch pour les logs
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=mossombi-audit

# Grafana Dashboard
GRAFANA_ENABLED=false
GRAFANA_URL=http://localhost:3001

# Sentry pour le monitoring d'erreurs
SENTRY_ENABLED=false
SENTRY_DSN=your_sentry_dsn

# =====================================================
# 🚀 DEPLOYMENT
# =====================================================
# Docker
DOCKER_ENABLED=true

# Load Balancer
LOAD_BALANCER_ENABLED=false
LOAD_BALANCER_IP=10.0.0.1

# SSL/TLS
SSL_ENABLED=true
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# =====================================================
# 🧪 TESTING
# =====================================================
# Désactiver en production
TESTING_MODE=false
MOCK_WHATSAPP=false
MOCK_EMAIL=false
MOCK_SMS=false
